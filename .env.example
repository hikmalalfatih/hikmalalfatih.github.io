# Public values embedded in the static site at build time; safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only values: set with Supabase Edge Function secrets, never in GitHub Pages variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
RESEND_API_KEY=re_replace-with-resend-api-key
CONTACT_TO_EMAIL=your-email-address
CONTACT_FROM_EMAIL=onboarding@resend.dev
SERVER_SALT=replace-with-a-random-value-of-at-least-32-characters
SITE_URL=https://hikmalalfatih.github.io
TURNSTILE_SECRET_KEY=
